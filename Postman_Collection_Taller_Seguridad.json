			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Estado HTTP esperado es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"La respuesta es un arreglo de empleados\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an(\"array\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/empleados",
					"host": ["{{baseUrl}}"],
					"path": ["api", "empleados"]
				},
