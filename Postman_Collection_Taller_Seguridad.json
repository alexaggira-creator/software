							"pm.test(\"Autenticación exitosa de ADMIN con 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"No expone contraseñas ni hashes BCrypt\", function () {",
							"    var text = pm.response.text();",
							"    pm.expect(text).to.not.include(\"password\");",
							"    pm.expect(text).to.not.include(\"$2a$\");",
